#!/bin/sh
set -u

log_error() { printf '%s\n' "$1" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}"; }
if [ -z "${TRIM_PKGVAR:-}" ] || [ -z "${TRIM_APPDEST:-}" ]; then
  log_error "SAG Native requires TRIM_PKGVAR and TRIM_APPDEST from fnOS. Start SAG through the application center."
  exit 1
fi

command_dir="$(dirname "$0")"
runtime="/var/apps/python312/target/bin/python3"
node_runtime="/var/apps/nodejs_v22/target/bin/node"
run_dir="${TRIM_PKGVAR}/run"
log_dir="${TRIM_PKGVAR}/logs"
gateway_pid="${run_dir}/gateway.pid"
web_pid="${run_dir}/web.pid"
mcp_public_pid="${run_dir}/mcp-public.pid"
web_port_file="${run_dir}/web.port"
gateway_socket="${TRIM_APPDEST}/app.sock"
web_entry="${TRIM_APPDEST}/web/server.js"
web_root="${TRIM_APPDEST}/web"
gateway_log="${log_dir}/gateway.log"
web_log="${log_dir}/web.log"
mcp_public_log="${log_dir}/mcp-public.log"
# fnOS reserves and injects the port declared in manifest.service_port.  Do
# not provide an application fallback: otherwise a manifest/runtime mismatch
# could publish a stale, unreachable Agent configuration.
mcp_public_port="${TRIM_SERVICE_PORT:-}"
secret="${TRIM_PKGVAR}/internal-secret"

# fnpack invokes every callback in cmd/ (install_init, install_callback,
# main, upgrade_init, uninstall_callback, ...) under a single
# `defaults.run-as` — there is no per-command override. This package
# uses run-as=package, so its lifecycle commands and long-lived
# gateway/web daemons all run directly as the sag package user.
#
# The internal secret lives in TRIM_PKGVAR (== /vol1/@appdata/<pkg> on
# fnOS), NOT in TRIM_PKGETC (== /vol1/@appconf/<pkg>). fnpack treats
# @appconf as a shared config volume whose perms it manages itself and
# does not re-normalize on upgrade — a prior install that left the
# secret 0700 root:root at @appconf/sag/internal-secret would then be
# unreadable to the sag package user forever. @appdata/sag is
# package-owned, so we can always heal it here.
#
# The gateway UDS lives at $TRIM_APPDEST/app.sock — fnpack's own
# gateway proxy reads from there based on the `gatewaySocket` field in
# app/ui/config. fnpack grants the package user access to package paths.

# Run in the launcher shell, before any daemon is forked. The sag package
# user can raise only the soft limit, up to the hard limit inherited from
# fnpack. Its gateway children then pass the same limits to tenant workers.
# SAG_NATIVE_NOFILE overrides the target; it never lowers an existing limit.
configure_nofile() {
  _sag_nofile_target="${SAG_NATIVE_NOFILE-4096}"
  case "$_sag_nofile_target" in
    ''|*[!0-9]*) _sag_nofile_target=invalid ;;
  esac
  if ! [ "$_sag_nofile_target" -gt 0 ] 2>/dev/null; then
    log_error "SAG Native SAG_NATIVE_NOFILE must be a positive integer. Unset it to use 4096, or correct it and restart SAG."
    return 1
  fi
  # Normalize decimal values before comparing the kernel's readback.
  while [ "${_sag_nofile_target#0}" != "$_sag_nofile_target" ]; do
    _sag_nofile_target="${_sag_nofile_target#0}"
  done
  _sag_nofile_soft="$(ulimit -S -n 2>/dev/null)" &&
    _sag_nofile_hard="$(ulimit -H -n 2>/dev/null)" || {
      log_error "SAG Native cannot read NOFILE limits. Check the package launch shell supports ulimit -S/-H -n and restart SAG."
      return 1
    }
  _sag_nofile_effective="$_sag_nofile_target"
  _sag_nofile_note=""
  if [ "$_sag_nofile_hard" != unlimited ] && [ "$_sag_nofile_effective" -gt "$_sag_nofile_hard" ]; then
    _sag_nofile_effective="$_sag_nofile_hard"
    _sag_nofile_note=" (clamped to inherited hard limit)"
  fi
  if [ "$_sag_nofile_soft" = unlimited ]; then
    _sag_nofile_effective=unlimited
  elif [ "$_sag_nofile_soft" -gt "$_sag_nofile_effective" ]; then
    _sag_nofile_effective="$_sag_nofile_soft"
  fi
  if [ "$_sag_nofile_soft" != "$_sag_nofile_effective" ]; then
    # Explicit -S preserves hard; a standalone child setting its own limit
    # would not affect this launcher or the daemons launched below.
    if ! ulimit -S -n "$_sag_nofile_effective"; then
      _sag_nofile_actual="$(ulimit -S -n 2>/dev/null)"
      _sag_nofile_hard="$(ulimit -H -n 2>/dev/null)"
      log_error "SAG Native cannot set NOFILE target=$_sag_nofile_target: effective=$_sag_nofile_actual hard=$_sag_nofile_hard. Check package launch limits and SAG_NATIVE_NOFILE, then restart SAG."
      return 1
    fi
  fi
  _sag_nofile_actual="$(ulimit -S -n 2>/dev/null)"
  if [ "$_sag_nofile_actual" != "$_sag_nofile_effective" ]; then
    log_error "SAG Native NOFILE verification failed: requested=$_sag_nofile_effective effective=$_sag_nofile_actual hard=$_sag_nofile_hard. Check package launch limits and restart SAG."
    return 1
  fi
  printf 'SAG Native launcher NOFILE soft=%s target=%s effective=%s hard=%s%s\n' "$_sag_nofile_soft" "$_sag_nofile_target" "$_sag_nofile_actual" "$_sag_nofile_hard" "$_sag_nofile_note"
}

# prepare_secret returns 0 iff main can safely hand the secret to the
# gateway. Called as the package user at the top of start. It can heal
# package-owned residue:
#
#   * missing / malformed / truncated → rewrite
#   * refuse a symlink (won't chase into someone else's dir)
#
# The write is 0600, so the gateway can read it through
# SAG_FNOS_INTERNAL_SECRET_FILE.
hex_ok() {
  case "$1" in
    "") return 1 ;;
    *[!0-9a-f]*) return 1 ;;
    ????????????????????????????????????????????????????????????????) return 0 ;;
    *) return 1 ;;
  esac
}

generate_secret_material() {
  if command -v openssl >/dev/null 2>&1; then
    material="$(openssl rand -hex 32 2>/dev/null | tr -d '\n\r\t ')"
    if hex_ok "$material"; then printf '%s' "$material"; return 0; fi
  fi
  if command -v xxd >/dev/null 2>&1; then
    material="$(head -c 32 /dev/urandom 2>/dev/null | xxd -p 2>/dev/null | tr -d '\n\r\t ')"
    if hex_ok "$material"; then printf '%s' "$material"; return 0; fi
  fi
  if command -v od >/dev/null 2>&1; then
    material="$(head -c 32 /dev/urandom 2>/dev/null | od -An -v -tx1 2>/dev/null | tr -d '\n\r\t ')"
    if hex_ok "$material"; then printf '%s' "$material"; return 0; fi
  fi
  return 1
}

secret_content_ok() {
  test -f "$1" || return 1
  bytes="$(wc -c <"$1" 2>/dev/null | tr -d ' \n\t')"
  test "$bytes" = 64 || return 1
  content="$(cat "$1" 2>/dev/null)" || return 1
  hex_ok "$content"
}

prepare_secret() {
  if [ -L "$secret" ]; then
    log_error "SAG Native internal secret at $secret is a symlink; refusing. Delete it manually and restart."
    return 1
  fi
  if secret_content_ok "$secret" && [ -r "$secret" ]; then
    chmod 600 "$secret" 2>/dev/null || :
    return 0
  fi
  umask 077
  if [ -e "$secret" ]; then
    rm -f "$secret" 2>/dev/null || :
  fi
  if [ ! -w "$(dirname "$secret")" ]; then
    log_error "SAG Native cannot rewrite internal secret: $(dirname "$secret") is not writable by uid=$(id -u 2>/dev/null || echo ?). $(ls -ld "$(dirname "$secret")" 2>&1)."
    return 1
  fi
  material="$(generate_secret_material)" || {
    log_error "SAG Native cannot regenerate internal secret: no working RNG (need openssl, xxd, or od + /dev/urandom)."
    return 1
  }
  if ! printf '%s' "$material" >"$secret" 2>/dev/null; then
    log_error "SAG Native cannot write internal secret at $secret. $(ls -ld "$(dirname "$secret")" 2>&1)."
    return 1
  fi
  chmod 600 "$secret" 2>/dev/null || :
  return 0
}

write_pid() {
  (
  pid_file="$1" pid="$2"
  temporary="${pid_file}.tmp.$$"
  if ! { printf '%s\n' "$pid" > "$temporary" && mv -f "$temporary" "$pid_file"; }; then
    rm -f "$temporary"
    log_error "SAG Native cannot write process record $pid_file. Check run directory permissions and restart SAG."
    return 1
  fi
  )
}

# Keep this file for the lifetime of DATA: unlinking a locked file would
# allow another invocation to lock a different inode. Daemons close fd 9.
acquire_lifecycle_lock() {
  if ! command -v flock >/dev/null 2>&1; then
    log_error "SAG Native requires flock to serialize service lifecycle commands. Restore the fnOS flock utility and retry."
    return 1
  fi
  if ! mkdir -p "$run_dir"; then
    log_error "SAG Native cannot create lifecycle lock directory $run_dir. Check DATA permissions and retry."
    return 1
  fi
  # `command` removes exec's special-builtin fatal-redirection behavior
  # in dash, while retaining the descriptor for the launcher lifetime.
  if ! command exec 9>"${run_dir}/lifecycle.lock"; then
    log_error "SAG Native cannot open lifecycle lock ${run_dir}/lifecycle.lock. Check DATA run-directory permissions and remove a directory or invalid file at that path before retrying."
    return 1
  fi
  if ! flock -w 60 "${1:--x}" 9; then
    log_error "SAG Native could not acquire the lifecycle lock within 60s. Check the preceding start/stop command and retry."
    return 1
  fi
}

valid_pid() {
  (
  pid_file="$1" expected="$2" service="${3:-}" attempt=0
  test -f "$pid_file" || return 1
  # stop passes its captured PID: never validate one PID then signal a
  # second value read from a concurrently replaced process record.
  if [ "$#" -ge 4 ]; then pid="$4"; else pid="$(cat "$pid_file")"; fi
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  # Next rewrites its process title to "next-server", which on Linux also
  # rewrites /proc/<pid>/cmdline.  Identify such services by the launch
  # environment marker instead: /proc/<pid>/environ is immutable.
  command="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  case "$command" in *"$expected"*) return 0 ;; esac
  if test -n "$service"; then
    while test "$attempt" -lt 3; do
      tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qx "SAG_NATIVE_SERVICE=$service" && return 0
      attempt=$((attempt + 1))
      sleep 0.1
    done
  fi
  return 1
  )
}

pid_start_time() {
  (
  process_stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  # comm (field 2) can contain spaces and parentheses. Everything after
  # its final ') ' is the fixed numeric/state part of the kernel record.
  process_stat="${process_stat##*) }"
  set -f
  set -- $process_stat
  [ "$#" -ge 20 ] || return 1
  shift 19
  printf '%s\n' "$1"
  )
}

stop_process() {
  (
  pid_file="$1" expected="$2" service="${3:-}" waited=0
  pid="$(cat "$pid_file" 2>/dev/null)" || pid=""
  if ! valid_pid "$pid_file" "$expected" "$service" "$pid"; then
    rm -f "$pid_file" || { log_error "SAG Native cannot remove stale process record $pid_file. Check DATA permissions before retrying."; return 1; }
    return 0
  fi
  started="$(pid_start_time "$pid")" || {
    log_error "SAG Native cannot verify process identity for pid=$pid. Inspect $pid_file before retrying stop."
    return 1
  }
  if ! kill -TERM "$pid" 2>/dev/null && valid_pid "$pid_file" "$expected" "$service" "$pid"; then
    log_error "SAG Native cannot stop pid=$pid. Check package process ownership and retry."
    return 1
  fi
  while [ "$(pid_start_time "$pid")" = "$started" ] && valid_pid "$pid_file" "$expected" "$service" "$pid" && test "$waited" -lt 15; do
    sleep 1
    waited=$((waited + 1))
  done
  # A recycled PID must not receive the delayed SIGKILL.
  if [ "$(pid_start_time "$pid")" = "$started" ] && valid_pid "$pid_file" "$expected" "$service" "$pid"; then
    kill -KILL "$pid" 2>/dev/null || {
      log_error "SAG Native cannot force-stop pid=$pid. Inspect package processes before retrying."
      return 1
    }
    waited=0
    while [ "$(pid_start_time "$pid")" = "$started" ] && valid_pid "$pid_file" "$expected" "$service" "$pid"; do
      if test "$waited" -ge 50; then
        log_error "SAG Native pid=$pid did not exit after SIGKILL. Inspect package processes before retrying stop or upgrade."
        return 1
      fi
      sleep 0.1
      waited=$((waited + 1))
    done
  fi
  rm -f "$pid_file"
  )
}

stop_tenant_workers() {
  # fnpack can deliver cmd before replacing app/runtime during upgrade.
  if ! "$runtime" "$command_dir/stop_workers.py" --root "$TRIM_PKGVAR" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>&1; then
    log_error "SAG Native tenant worker stop verification failed. Check the worker diagnostic above; do not back up or rebuild knowledge until all package workers have exited."
    return 1
  fi
}

wait_for_web() {
  (
  waited=0
  while test "$waited" -lt 15; do
    if curl -fsS --max-time 2 "http://127.0.0.1:${web_port}/app/sag/chat" >/dev/null 2>> "$gateway_log"; then return 0; fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
  )
}

select_web_port() {
  (
  candidate=3091
  while test "$candidate" -le 3191; do
    if ! ss -ltn 2>/dev/null | grep -Eq "[:.]${candidate}[[:space:]]"; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate=$((candidate + 1))
  done
  return 1
  )
}

wait_for_gateway_socket() {
  (
  waited=0
  while test "$waited" -lt 15; do
    if test -S "$gateway_socket" && valid_pid "$gateway_pid" "sag_api.fnos.cli" && gateway_healthy; then return 0; fi
    # If the process died during the wait loop, don't waste 14 more
    # seconds polling a corpse — surface the log tail and bail.
    if test "$waited" -ge 2 && ! valid_pid "$gateway_pid" "sag_api.fnos.cli"; then
      log_error "SAG Native gateway process died during startup (waited ${waited}s). Last 20 lines of gateway.log: $(tail -n 20 "$gateway_log" 2>/dev/null | tr '\n' ' ' | head -c 800). Socket: $(ls -l "$gateway_socket" 2>&1)."
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  # Timed out after 15s — the process may still be alive but not serving.
  log_error "SAG Native gateway did not become ready within 15s. Socket exists: $(test -S "$gateway_socket" && echo yes || echo no). PID alive: $(valid_pid "$gateway_pid" "sag_api.fnos.cli" && echo yes || echo no). Last 20 lines of gateway.log: $(tail -n 20 "$gateway_log" 2>/dev/null | tr '\n' ' ' | head -c 800)."
  return 1
  )
}

gateway_healthy() {
  curl -fsS --max-time 5 --unix-socket "$gateway_socket" http://localhost/healthz 2>> "$gateway_log" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"'
}

status_check_with_retry() {
  # Retry a probe up to 3 times with a 1s backoff so a single cold-start hiccup
  # (a healthz round-trip briefly crossing --max-time, a transient /proc read)
  # does not exit 3 and cause the fnOS app center to force-close the iframe.
  (
  attempt=0
  while test "$attempt" -lt 3; do
    "$@" && return 0
    attempt=$((attempt + 1))
    sleep 1
  done
  return 1
  )
}

web_healthy() {
  curl -fsS --max-time 8 "http://127.0.0.1:${web_port}/app/sag/chat" >/dev/null 2>> "$web_log"
}

# Only registered as the EXIT trap during "main start".  The trap makes
# sure EVERY non-zero exit from the start path — even an unexpected one —
# leaves at least a pid/dir/log-tail breadcrumb in TRIM_TEMP_LOGFILE so
# fnpack never shows the generic "执行脚本出错且原因未知".
_start_crash_trap() {
  s=$?
  if [ "$s" -ne 0 ]; then
    log_error "SAG Native start exited with code $s (last step: ${_START_STEP:-<startup>}). UID=$(id -u 2>/dev/null || echo ?) GID=$(id -g 2>/dev/null || echo ?). GW log: $(tail -n 20 "$gateway_log" 2>/dev/null | tr '\n' ' ' | head -c 800). Secret: $(ls -l "$secret" 2>&1). Socket dir: $(ls -ld "$(dirname "$gateway_socket")" 2>&1)."
  fi
}

case "${1:-}" in
  start)
    trap _start_crash_trap EXIT

    _START_STEP="mkdir"
    mkdir -p "$run_dir" "$log_dir" || {
      log_error "SAG Native cannot create run/log dirs under $TRIM_PKGVAR. UID=$(id -u 2>/dev/null || echo ?). Parent dir: $(ls -ld "$TRIM_PKGVAR" 2>&1)."
      exit 1
    }
    # Verify the gateway log is writable BEFORE we launch anything that
    # redirects into it. A silent redirect failure (read-only fs, wrong
    # owner, missing parent dir) would otherwise swallow the real error
    # and leave gateway.log empty — the operator would see nothing at all.
    _START_STEP="touch-gateway-log"
    if ! touch "$gateway_log" "$web_log" 2>/dev/null; then
      log_error "SAG Native cannot write gateway/web log at $log_dir. UID=$(id -u 2>/dev/null || echo ?). Dir: $(ls -ld "$log_dir" 2>&1)."
      exit 1
    fi
    _START_STEP="configure-nofile"
    configure_nofile >> "$gateway_log" 2>&1 || exit 1
    _START_STEP="lifecycle-lock"
    acquire_lifecycle_lock || exit 1
    # Warm the operator if the socket dir is not writable by us so the
    # eventual PermissionError in uvicorn is not a surprise.
    _START_STEP="check-socket-dir"
    if [ ! -w "$(dirname "$gateway_socket")" ]; then
      log_error "SAG Native gateway socket directory $(dirname "$gateway_socket") is not writable by uid=$(id -u 2>/dev/null || echo ?). $(ls -ld "$(dirname "$gateway_socket")" 2>&1). uvicorn will be unable to bind the UDS."
      # Don't exit — maybe an ACL grants write after all. The gateway
      # launch will surface the real errno either way.
    fi

    export PATH="/var/apps/python312/target/bin:/var/apps/nodejs_v22/target/bin:$PATH"
    export PYTHONPATH="${TRIM_APPDEST}/server/vendor:${TRIM_APPDEST}/server${PYTHONPATH:+:$PYTHONPATH}"
    export SAG_FNOS_DATA_ROOT="${TRIM_PKGVAR}"
    if [ -z "${TRIM_PKGTMP:-}" ]; then
      log_error "SAG Native requires TRIM_PKGTMP from fnOS. Start SAG through the application center."
      exit 1
    fi
    export SAG_FNOS_TEMP_ROOT="${TRIM_PKGTMP}"
    export SAG_FNOS_INTERNAL_SECRET_FILE="$secret"

    _START_STEP="check-runtimes"
    if ! test -x "$runtime"; then log_error "SAG Native runtime payload is unavailable: python3 missing at $runtime."; exit 1; fi
    if ! test -x "$node_runtime"; then log_error "SAG Native runtime payload is unavailable: node missing at $node_runtime."; exit 1; fi
    if ! test -f "$web_entry"; then log_error "SAG Native runtime payload is unavailable: web entry missing at $web_entry."; exit 1; fi
    if ! test -d "$web_root"; then log_error "SAG Native runtime payload is unavailable: web root missing at $web_root."; exit 1; fi

    # A crashed gateway can leave older independent tenant workers writing.
    # Confirm they exited before a replacement gateway classifies cold DATA.
    # An already running gateway still owns its workers; keep them untouched.
    _START_STEP="stop-orphan-workers"
    if ! valid_pid "$gateway_pid" "sag_api.fnos.cli"; then
      stop_tenant_workers || exit 1
    fi

    _START_STEP="prepare-secret"
    prepare_secret || exit 1

    _START_STEP="start-web"
    if valid_pid "$web_pid" "$web_entry" "web" && test -f "$web_port_file"; then
      web_port="$(cat "$web_port_file")" || { log_error "SAG Native cannot read web port record $web_port_file. Check DATA permissions and retry."; exit 1; }
    else
      web_port="$(select_web_port)" || { log_error "No free local port for SAG Native web service."; exit 1; }
      cd "$web_root" || { log_error "SAG Native cannot enter web directory $web_root."; exit 1; }
      ( exec 9>&-; SAG_NATIVE_SERVICE="web" HOSTNAME=127.0.0.1 PORT="$web_port" "$node_runtime" "$web_entry" ) >> "$web_log" 2>&1 &
      web_process=$!
      write_pid "$web_pid" "$web_process" || { kill -TERM "$web_process" 2>/dev/null || :; exit 1; }
      write_pid "$web_port_file" "$web_port" || { stop_process "$web_pid" "$web_entry" "web"; exit 1; }
    fi

    _START_STEP="wait-web"
    if ! wait_for_web; then
      log_error "SAG Native web process did not become ready within 15s. Web log tail: $(tail -n 20 "$web_log" 2>/dev/null | tr '\n' ' ' | head -c 800)."
      stop_process "$web_pid" "$web_entry" "web"
      exit 1
    fi

    # The gateway can also exit while Web is becoming ready. Reconfirm its
    # tenants have exited at the actual replacement boundary.
    _START_STEP="start-gateway"
    if ! valid_pid "$gateway_pid" "sag_api.fnos.cli"; then
      stop_tenant_workers || exit 1
      rm -f "$gateway_socket" || { log_error "SAG Native cannot remove stale gateway socket $gateway_socket."; exit 1; }
      ( exec 9>&-; "$runtime" -m sag_api.fnos.cli gateway --socket "$gateway_socket" --web-origin "http://127.0.0.1:${web_port}" ) >> "$gateway_log" 2>&1 &
      gw_pid=$!
      write_pid "$gateway_pid" "$gw_pid" || { kill -TERM "$gw_pid" 2>/dev/null || :; stop_process "$web_pid" "$web_entry" "web"; exit 1; }
      # Give Python ~1s to import + settle, then check it is still alive.
      # A quick death (permission denied on sqlite, missing native dep,
      # config parse error, secret mode != 0600, etc.) would otherwise be
      # invisible until wait_for_gateway_socket times out 15s later with
      # the useless "gateway process is not running" line. Surface a tail
      # of the log so the operator can act on the real errno.
      sleep 1
      if ! kill -0 "$gw_pid" 2>/dev/null; then
        gw_tail="$(tail -n 20 "$gateway_log" 2>/dev/null | tr '\n' ' ' | head -c 800)"
        log_error "SAG Native gateway process exited immediately after launch (pid=$gw_pid). Last gateway.log: ${gw_tail:-<empty>}"
        stop_process "$web_pid" "$web_entry" "web"
        rm -f "$gateway_pid" "$gateway_socket"
        exit 1
      fi
    fi

    _START_STEP="wait-gateway"
    wait_for_gateway_socket || {
      # wait_for_gateway_socket already wrote its own log_error; this arm
      # only cleans up so the next start is from a blank slate.
      stop_process "$gateway_pid" "sag_api.fnos.cli"
      stop_process "$web_pid" "$web_entry" "web"
      exit 1
    }

    # External Agents cannot traverse fnOS' desktop authentication Nginx
    # layer. The public listener exposes only /mcp/ and forwards every
    # request into the healthy UDS gateway above. It is intentionally
    # optional: a port collision or missing fnOS port assignment must not
    # make the SAG desktop app unusable.
    _START_STEP="start-public-mcp"
    if [ -z "$mcp_public_port" ]; then
      log_error "SAG Native public MCP listener is disabled: fnOS did not provide TRIM_SERVICE_PORT. The desktop app remains available."
    elif ! valid_pid "$mcp_public_pid" "sag_api.fnos.cli" "mcp-public"; then
      if touch "$mcp_public_log" 2>/dev/null; then
        ( exec 9>&-; SAG_NATIVE_SERVICE="mcp-public" "$runtime" -m sag_api.fnos.cli mcp-proxy --socket "$gateway_socket" --host 0.0.0.0 --port "$mcp_public_port" ) >> "$mcp_public_log" 2>&1 &
        mcp_public_process=$!
        if ! write_pid "$mcp_public_pid" "$mcp_public_process"; then
          kill -TERM "$mcp_public_process" 2>/dev/null || :
          log_error "SAG Native public MCP listener failed to record its process; the desktop app remains available."
        else
          sleep 1
          if ! kill -0 "$mcp_public_process" 2>/dev/null; then
            rm -f "$mcp_public_pid"
            mcp_public_tail="$(tail -n 20 "$mcp_public_log" 2>/dev/null | tr '\n' ' ' | head -c 800)"
            log_error "SAG Native public MCP listener failed to start; the desktop app remains available. Last mcp-public.log: ${mcp_public_tail:-<empty>}"
          fi
        fi
      else
        log_error "SAG Native public MCP listener failed to start; the desktop app remains available. Cannot write $mcp_public_log."
      fi
    fi

    # Success — disarm the crash trap so stop/status are not affected.
    trap - EXIT
    ;;
  stop)
    trap 's=$?; if [ "$s" -ne 0 ]; then log_error "SAG Native stop failed (code $s). Inspect package processes and DATA permissions before retrying."; fi' EXIT
    acquire_lifecycle_lock || exit 1
    stop_process "$mcp_public_pid" "sag_api.fnos.cli" "mcp-public" ||
      exit 1
    stop_process "$gateway_pid" "sag_api.fnos.cli" || exit 1
    stop_tenant_workers || exit 1
    stop_process "$web_pid" "$web_entry" "web" || exit 1
    rm -f "$gateway_socket" "$web_port_file" || { log_error "SAG Native cannot remove stopped socket/port records. Check package directory permissions."; exit 1; }
    ;;
  status)
    trap 's=$?; if [ "$s" -ne 0 ] && [ "$s" -ne 3 ]; then log_error "SAG Native status failed (code $s). Check DATA permissions and the lifecycle lock before retrying."; fi' EXIT
    acquire_lifecycle_lock -s || exit 1
    if ! status_check_with_retry valid_pid "$gateway_pid" "sag_api.fnos.cli"; then
      log_error "SAG Native gateway process is not running."
      exit 3
    fi
    if ! status_check_with_retry valid_pid "$web_pid" "$web_entry" "web"; then
      log_error "SAG Native web process is not running."
      exit 3
    fi
    if ! test -S "$gateway_socket"; then
      log_error "SAG Native gateway socket is missing."
      exit 3
    fi
    if ! status_check_with_retry gateway_healthy; then
      log_error "SAG Native gateway health check failed; inspect gateway.log."
      exit 3
    fi
    if ! test -f "$web_port_file"; then
      log_error "SAG Native web port record is missing."
      exit 3
    fi
    web_port="$(cat "$web_port_file")" || { log_error "SAG Native cannot read web port record $web_port_file. Check DATA permissions and retry."; exit 3; }
    if ! status_check_with_retry web_healthy; then
      log_error "SAG Native web health check failed; inspect web.log."
      exit 3
    fi
    ;;
  *) log_error "SAG Native expects start, stop or status. Use the fnOS application center to control SAG."; exit 1 ;;
esac
