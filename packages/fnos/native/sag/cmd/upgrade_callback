#!/bin/sh
# upgrade_callback — heal ownership/perm drift after an upgrade.
#
# Runs as the sag package user (config/privilege defaults.run-as=package). fnpack invokes
# this callback after swapping in the new package payload. Stop any
# inherited service here, rather than relying on the old package's
# upgrade_init to have done so: otherwise the next start can reuse an
# in-memory Web/Gateway pair from the old payload.

set -u

command_dir="$(dirname "$0")"

# Stop every writer before classifying SQLite, verifying the cold backup and
# rebuilding recognized old knowledge under the same lifecycle lock. Recheck
# here even if the installed payload's upgrade_init predates these safeguards.
# Normal workers never perform this reset.
if ! "$command_dir/main" upgrade-knowledge; then
  log_file="${TRIM_TEMP_LOGFILE:-}"
  if [ -n "$log_file" ]; then
    printf 'upgrade_callback: knowledge update failed; keep the data and backup before retrying\n' >>"$log_file" 2>/dev/null || :
  fi
  exit 1
fi

exit 0
