#!/bin/sh
# install_init — pre-install cleanup shell.
#
# fnpack invokes install_init BEFORE the framework guarantees
# $TRIM_PKGVAR (== /vol1/@appdata/<pkg>) exists on disk. Community
# reference apps (veenyi/Fnos-Hermes-Studio, LionLuo-an/LiteReader,
# AngeVox/AngeVoice) confirm this: any write under $TRIM_PKGVAR during
# install_init is racy. The framework materializes $TRIM_PKGVAR after
# install_init returns and BEFORE install_callback runs, so
# mkdir/chown/secret provisioning belongs there — see cmd/install_callback.
#
# What install_init IS good for: reaping stale processes and sockets left
# behind by an unclean uninstall of a previous version. Everything here
# is best-effort — a fresh install with no residue must exit 0.
#
# Runs as root (config/privilege defaults.run-as=root). cmd/main drops to
# the sag package user before launching gateway/web via setpriv.

set -u

log_file="${TRIM_TEMP_LOGFILE:-}"
log() {
  if [ -n "$log_file" ]; then
    printf 'install_init: %s\n' "$*" >>"$log_file" 2>/dev/null && return 0
  fi
  printf 'install_init: %s\n' "$*" >&2
}

# Reap any stray processes from a previous install that were not stopped
# cleanly. Look for the exact module we launch ("sag_api.fnos.cli") and
# the web server entry ("server.js" under an appdest ending in /sag/web).
# `pkill -f` needs a pattern specific enough to avoid clobbering
# unrelated processes.
if command -v pkill >/dev/null 2>&1; then
  pkill -f 'python.*-m sag_api\.fnos\.cli' 2>/dev/null || :
  pkill -f 'node .*/sag/[^ ]*/web/server\.js' 2>/dev/null || :
fi

# Best-effort remove a stale UDS at the well-known appdest path. fnpack
# will overwrite the appdest tree anyway, but a bound socket file left
# by a crashed process can confuse uvicorn's bind on the next start.
if [ -n "${TRIM_APPDEST:-}" ] && [ -S "$TRIM_APPDEST/app.sock" ]; then
  rm -f "$TRIM_APPDEST/app.sock" 2>/dev/null || :
fi

log "pre-install cleanup complete"
exit 0
