#!/bin/bash

log_status_error() {
    printf '%s\n' "$1" >> "${TRIM_TEMP_LOGFILE}"
}

compose_file="${TRIM_APPDEST}/docker/docker-compose.yaml"

compose_sag() {
    docker compose --project-name sag -f "${compose_file}" "$@"
}

case "${1:-}" in
start|stop)
    # The fnOS docker-project resource owns Compose start and stop.
    exit 0
    ;;
status)
    gateway_id="$(compose_sag ps -q gateway 2>> "${TRIM_TEMP_LOGFILE}")" || {
        log_status_error "SAG gateway is not running."
        exit 3
    }
    if [ -z "${gateway_id}" ]; then
        log_status_error "SAG gateway is not running."
        exit 3
    fi

    gateway_state="$(docker inspect --format '{{.State.Status}}' "${gateway_id}" 2>> "${TRIM_TEMP_LOGFILE}")" || {
        log_status_error "SAG gateway is not running."
        exit 3
    }
    if [ "${gateway_state}" != running ]; then
        log_status_error "SAG gateway is not running."
        exit 3
    fi

    gateway_health="$(docker inspect --format '{{.State.Health.Status}}' "${gateway_id}" 2>> "${TRIM_TEMP_LOGFILE}")" || {
        log_status_error "SAG gateway is not healthy."
        exit 3
    }
    if [ "${gateway_health}" != healthy ]; then
        log_status_error "SAG gateway is not healthy."
        exit 3
    fi

    if ! curl -fsS --max-time 5 "http://127.0.0.1:${TRIM_SERVICE_PORT}/api/v1/system/ready" >/dev/null 2>> "${TRIM_TEMP_LOGFILE}"; then
        log_status_error "SAG API readiness check failed."
        exit 3
    fi
    exit 0
    ;;
*)
    exit 1
    ;;
esac
