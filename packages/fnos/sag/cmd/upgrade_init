#!/bin/bash

set -u

log_error() {
    printf '%s\n' "$1" >> "${TRIM_TEMP_LOGFILE}"
}

umask 077

compose_file="${TRIM_APPDEST}/docker/docker-compose.yaml"

compose_sag() {
    docker compose --project-name sag -f "${compose_file}" "$@"
}

canonical_dir() {
    (cd -P -- "$1" 2>/dev/null && pwd -P)
}

validate_owned_canonical_dir() {
    candidate="${1%/}"
    label="$2"
    case "${candidate}" in
        /*) ;;
        *) log_error "SAG upgrade rejected unsafe ${label} mount source: path is not absolute."; return 1 ;;
    esac
    if [ ! -d "${candidate}" ] || [ -L "${candidate}" ] || [ ! -O "${candidate}" ]; then
        log_error "SAG upgrade rejected unsafe ${label} mount source."
        return 1
    fi
    resolved="$(canonical_dir "${candidate}")" || {
        log_error "SAG upgrade could not resolve ${label} mount source; verify callback identity and execute permission on the full ancestor chain."
        return 1
    }
    if [ "${resolved}" != "${candidate}" ]; then
        log_error "SAG upgrade rejected unsafe noncanonical ${label} mount source."
        return 1
    fi
}

pkgvar_dir="${TRIM_PKGVAR}"
while [ "${pkgvar_dir}" != "/" ] && [ "${pkgvar_dir%/}" != "${pkgvar_dir}" ]; do
    pkgvar_dir="${pkgvar_dir%/}"
done
data_dir="${pkgvar_dir}/data"
backup_dir="${pkgvar_dir}/backup"

validate_owned_canonical_dir "${pkgvar_dir}" "package parent" || exit 1

if [ ! -L "${data_dir}" ] && [ ! -e "${data_dir}" ]; then
    log_error "SAG upgrade aborted: the active data directory is missing."
    exit 1
fi
validate_owned_canonical_dir "${data_dir}" "data" || exit 1

backup_exists=0
if [ -L "${backup_dir}" ] || [ -e "${backup_dir}" ]; then
    validate_owned_canonical_dir "${backup_dir}" "backup" || exit 1
    backup_exists=1
fi

chmod 700 "${pkgvar_dir}" || {
    log_error "SAG upgrade could not protect its private package parent."
    exit 1
}
if [ "${backup_exists}" -eq 0 ] && ! mkdir -- "${backup_dir}"; then
    log_error "SAG upgrade could not prepare its backup directory."
    exit 1
fi
validate_owned_canonical_dir "${backup_dir}" "backup" || exit 1
if ! chmod 700 "${data_dir}" "${backup_dir}"; then
    log_error "SAG upgrade could not protect its private data and backup directories."
    exit 1
fi

data_kib="$(compose_sag --profile lifecycle run --rm --no-deps -T \
    -e SAG_LIFECYCLE_ACTION=size lifecycle-size /opt/sag-lifecycle.py 2>> "${TRIM_TEMP_LOGFILE}")" || {
    log_error "SAG upgrade could not measure the active data tree."
    exit 1
}
df_output="$(df -Pk "${backup_dir}" 2>> "${TRIM_TEMP_LOGFILE}")" || {
    log_error "SAG upgrade could not measure free backup space."
    exit 1
}
available_kib="$(awk 'NR == 2 {print $4}' <<< "${df_output}")" || {
    log_error "SAG upgrade could not parse the free-space measurement."
    exit 1
}

case "${data_kib}" in
    ''|*[!0-9]*)
        log_error "SAG upgrade received an invalid active data size."
        exit 1
        ;;
esac
case "${available_kib}" in
    ''|*[!0-9]*)
        log_error "SAG upgrade received invalid available backup space."
        exit 1
        ;;
esac

# Reserve 10 percent plus 1 MiB for archive metadata and compression variance.
required_kib=$((data_kib + (data_kib / 10) + 1024))
if [ "${available_kib}" -lt "${required_kib}" ]; then
    log_error "SAG upgrade aborted: insufficient free space for a full-data backup."
    exit 1
fi

running_ids="$(compose_sag ps --status running -q 2>> "${TRIM_TEMP_LOGFILE}")" || {
    log_error "SAG upgrade could not determine whether this hook must recover running services."
    exit 1
}
hook_stopped_services=0
if [ -n "${running_ids}" ]; then
    hook_stopped_services=1
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)" || timestamp="unknown-time"
archive="${backup_dir}/sag-data-${timestamp}-$$.tar.gz"
archive_temp="${archive}.tmp"

cleanup() {
    status=$?
    rm -f -- "${archive_temp}"
    if [ "${hook_stopped_services}" -eq 1 ]; then
        compose_sag start >> "${TRIM_TEMP_LOGFILE}" 2>&1 || true
    fi
    exit "${status}"
}
trap cleanup EXIT HUP INT TERM

if ! compose_sag stop >> "${TRIM_TEMP_LOGFILE}" 2>&1; then
    log_error "SAG upgrade could not stop services for a cold backup."
    exit 1
fi

validate_owned_canonical_dir "${data_dir}" "data" || exit 1
validate_owned_canonical_dir "${backup_dir}" "backup" || exit 1
if ! compose_sag --profile lifecycle run --rm --no-deps -T \
    -e SAG_LIFECYCLE_ACTION=backup -e "SAG_ARCHIVE_TEMP=/backup/${archive_temp##*/}" \
    lifecycle-backup /opt/sag-lifecycle.py >> "${TRIM_TEMP_LOGFILE}" 2>&1; then
    log_error "SAG upgrade backup archive failed; active data was not changed."
    exit 1
fi

if ! mv -- "${archive_temp}" "${archive}"; then
    log_error "SAG upgrade could not atomically publish the backup archive."
    exit 1
fi

# A successful pre-upgrade backup deliberately leaves the old application
# stopped. The fnOS docker-project resource owns replacement and startup.
trap - EXIT HUP INT TERM
exit 0
