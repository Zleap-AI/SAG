#!/bin/bash

set -u

case "${SAG_DELETE_DATA:-false}" in
true)
    pkgvar_dir="${TRIM_PKGVAR}"
    while [ "${pkgvar_dir}" != "/" ] && [ "${pkgvar_dir%/}" != "${pkgvar_dir}" ]; do
        pkgvar_dir="${pkgvar_dir%/}"
    done
    data_dir="${pkgvar_dir}/data"
    compose_file="${TRIM_APPDEST}/docker/docker-compose.yaml"
    compose_sag() {
        docker compose --project-name sag -f "${compose_file}" "$@"
    }
    if [ -L "${data_dir}" ] || [ -e "${data_dir}" ]; then
        canonical_dir() {
            (cd -P -- "$1" 2>/dev/null && pwd -P)
        }
        validate_owned_canonical_dir() {
            candidate="${1%/}"
            label="$2"
            case "${candidate}" in
                /*) ;;
                *) printf '%s\n' "SAG uninstall rejected unsafe ${label} mount source: path is not absolute." >> "${TRIM_TEMP_LOGFILE}"; return 1 ;;
            esac
            if [ ! -d "${candidate}" ] || [ -L "${candidate}" ] || [ ! -O "${candidate}" ]; then
                printf '%s\n' "SAG uninstall rejected unsafe ${label} mount source." >> "${TRIM_TEMP_LOGFILE}"
                return 1
            fi
            resolved="$(canonical_dir "${candidate}")" || {
                printf '%s\n' "SAG uninstall could not resolve ${label} mount source; verify callback identity and execute permission on the full ancestor chain." >> "${TRIM_TEMP_LOGFILE}"
                return 1
            }
            if [ "${resolved}" != "${candidate}" ]; then
                printf '%s\n' "SAG uninstall rejected unsafe noncanonical ${label} mount source." >> "${TRIM_TEMP_LOGFILE}"
                return 1
            fi
        }
        validate_owned_canonical_dir "${pkgvar_dir}" "package parent" || exit 1
        validate_owned_canonical_dir "${data_dir}" "data" || exit 1
        chmod 700 "${pkgvar_dir}" || {
            printf '%s\n' "SAG uninstall could not protect its private package parent." >> "${TRIM_TEMP_LOGFILE}"
            exit 1
        }
        chmod 700 "${data_dir}" || {
            printf '%s\n' "SAG uninstall could not protect its private mount parents." >> "${TRIM_TEMP_LOGFILE}"
            exit 1
        }
        if ! compose_sag --profile lifecycle run --rm --no-deps -T \
            -e SAG_LIFECYCLE_ACTION=delete lifecycle-delete /opt/sag-lifecycle.py \
            >> "${TRIM_TEMP_LOGFILE}" 2>&1; then
            printf '%s\n' "SAG uninstall could not delete the selected active data." >> "${TRIM_TEMP_LOGFILE}"
            exit 1
        fi
        if ! rmdir -- "${data_dir}"; then
            printf '%s\n' "SAG uninstall helper did not completely empty the active data directory." >> "${TRIM_TEMP_LOGFILE}"
            exit 1
        fi
    fi
    ;;
*)
    # Retain is the safe default. See RETAINED_DATA.md for the device-verification fallback.
    ;;
esac

exit 0
