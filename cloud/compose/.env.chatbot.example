# Copy to cloud/compose/.env.chatbot.local; this file is not a credential store.
SAG_CHATBOT_LLM_ENABLED=false
SAG_CHATBOT_EMBEDDING_ENABLED=false
SAG_LOCK_CHATBOT_CONFIG=false
# SAG_CHATBOT_LLM_PROVIDER=openai
# SAG_CHATBOT_LLM_BASE_URL=https://YOUR-CHAT-ENDPOINT/v1
# SAG_CHATBOT_LLM_MODEL=YOUR-CHAT-MODEL
# SAG_CHATBOT_LLM_API_KEY=YOUR-SEPARATE-CHAT-KEY
# SAG_CHATBOT_LLM_RESPONSES_PROVIDER=azure
# SAG_CHATBOT_LLM_RESPONSES_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/responses
# SAG_CHATBOT_LLM_RESPONSES_API_VERSION=v1
# SAG_CHATBOT_EMBEDDING_BASE_URL=https://YOUR-QUERY-ENDPOINT/v1
# SAG_CHATBOT_EMBEDDING_API_KEY=YOUR-SEPARATE-QUERY-KEY
# Supply a Fernet key through deployment secrets before saving new UI keys.
# SAG_CHATBOT_CONFIG_ENCRYPTION_KEY=YOUR-FERNET-KEY
